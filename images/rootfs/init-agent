#!/bin/sh
# Terrarium warm-pool idle image init (FS-M4).
#
# Boots to an idle shell with guest-proxy listening on vsock :1024 —
# no rootfs layers. The host hot-plugs a layered fs later (vm.add-fs)
# and asks guest-proxy to mount it.

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /tmp

# Bring up networking if a virtio-net device is present (DHCP via host NAT)
ip link set lo up 2>/dev/null
if ip link show eth0 2>/dev/null; then
    ip link set eth0 up
    udhcpc -i eth0 -n -q 2>/dev/null
    echo "nameserver 8.8.8.8" > /etc/resolv.conf 2>/dev/null
fi

echo "init: starting guest-proxy (vsock :1024)"
/bin/guest-proxy &

echo "Terrarium idle VM ready."
exec /bin/sh
