+
+    // ---- static fs grant mirror ----
+
+    /// Minimal NotifPolicy carrying only the fs grants under test.
+    fn fs_policy(readable: &[&str], writable: &[&str]) -> NotifPolicy {
+        NotifPolicy {
+            max_memory_bytes: 0,
+            max_processes: 0,
+            has_memory_limit: false,
+            has_net_destination_policy: false,
+            has_bind_denylist: false,
+            has_unix_fs_gate: !readable.is_empty() || !writable.is_empty(),
+            has_random_seed: false,
+            has_time_start: false,
+            time_offset: 0,
+            num_cpus: None,
+            argv_safety_required: false,
+            port_remap: false,
+            cow_enabled: false,
+            chroot_root: None,
+            chroot_readable: readable.iter().map(Into::into).collect(),
+            chroot_writable: writable.iter().map(Into::into).collect(),
+            chroot_denied: Vec::new(),
+            chroot_mounts: Vec::new(),
+            chroot_mount_ro: Vec::new(),
+            deterministic_dirs: false,
+            virtual_hostname: None,
+            has_http_acl: false,
+            virtual_etc_hosts: String::new(),
+            ca_inject_paths: Vec::new(),
+            ca_inject_pem: None,
+        }
+    }
+
+    /// Read of a path outside every grant mirrors a Landlock denial.
+    #[test]
+    fn fs_grant_read_outside_grants_is_denied() {
+        let policy = fs_policy(&["/usr"], &["/tmp"]);
+        let pfs = crate::seccomp::state::PolicyFnState::new();
+        assert_eq!(
+            deny_open_verdict(std::path::Path::new("/etc/passwd"), libc::O_RDONLY as u64, &policy, &pfs),
+            Some(libc::EACCES)
+        );
+        assert_eq!(
+            deny_open_verdict(std::path::Path::new("/usr/bin/ls"), libc::O_RDONLY as u64, &policy, &pfs),
+            None
+        );
+    }
+
+    /// Write access requires a writable grant; a readable grant is not enough.
+    #[test]
+    fn fs_grant_write_requires_writable() {
+        let policy = fs_policy(&["/usr"], &["/tmp"]);
+        let pfs = crate::seccomp::state::PolicyFnState::new();
+        assert_eq!(
+            deny_open_verdict(std::path::Path::new("/usr/x"), libc::O_WRONLY as u64, &policy, &pfs),
+            Some(libc::EACCES)
+        );
+        assert_eq!(
+            deny_open_verdict(std::path::Path::new("/tmp/x"), libc::O_RDWR as u64, &policy, &pfs),
+            None
+        );
+    }
+
+    /// Reads are allowed on writable grants (the writable rule is
+    /// read-inclusive, matching `deny_open_verdict`'s existing semantics).
+    #[test]
+    fn fs_grant_read_allowed_on_writable() {
+        let policy = fs_policy(&[], &["/tmp"]);
+        let pfs = crate::seccomp::state::PolicyFnState::new();
+        assert_eq!(
+            deny_open_verdict(std::path::Path::new("/tmp/x"), libc::O_RDONLY as u64, &policy, &pfs),
+            None
+        );
+    }
+
+    /// Prefix matching is component-wise: an exact grant on `/dev/null`
+    /// covers it, but not the sibling `/dev/nullx`.
+    #[test]
+    fn fs_grant_sibling_prefix_is_not_covered() {
+        let policy = fs_policy(&["/dev/null"], &[]);
+        let pfs = crate::seccomp::state::PolicyFnState::new();
+        assert_eq!(
+            deny_open_verdict(std::path::Path::new("/dev/null"), libc::O_RDONLY as u64, &policy, &pfs),
+            None
+        );
+        assert_eq!(
+            deny_open_verdict(std::path::Path::new("/dev/nullx"), libc::O_RDONLY as u64, &policy, &pfs),
+            Some(libc::EACCES)
+        );
+    }
+
+    /// O_CREAT/O_TRUNC imply write intent even with O_RDONLY access mode.
+    #[test]
+    fn fs_grant_create_implies_write() {
+        let policy = fs_policy(&["/usr"], &["/tmp"]);
+        let pfs = crate::seccomp::state::PolicyFnState::new();
+        assert_eq!(
+            deny_open_verdict(
+                std::path::Path::new("/usr/new"),
+                libc::O_CREAT as u64,
+                &policy,
+                &pfs
+            ),
+            Some(libc::EACCES)
+        );
+        assert_eq!(
+            deny_open_verdict(
+                std::path::Path::new("/tmp/new"),
+                libc::O_CREAT as u64,
+                &policy,
+                &pfs
+            ),
+            None
+        );
+    }
 }
