+/// Static-grant mirror for fs observability.
+///
+/// When the sandbox confines the filesystem in non-chroot mode, this
+/// resolves the notification's path and returns `Some(EACCES)` when the
+/// access is outside every fs grant — the same decision Landlock would
+/// make at the kernel, surfaced here so the deny channel records it.
+/// Returns `None` to soft-fall through: decode/resolution failures are
+/// left to the kernel (its own re-read fails the same way), and the
+/// Continue-only call site guarantees dedicated handlers (procfs shims,
+/// COW, ...) win before this gate. Landlock remains the enforcement
+/// backstop — this gate only mirrors its verdict for observability.
+fn static_fs_grant_deny(
+    notif: &SeccompNotif,
+    policy: &NotifPolicy,
+    pfs: &super::state::PolicyFnState,
+    notif_fd: RawFd,
+) -> Option<i32> {
+    if policy.chroot_root.is_some()
+        || (policy.chroot_readable.is_empty() && policy.chroot_writable.is_empty())
+    {
+        // Chroot mode: the chroot handlers own fs enforcement. No fs
+        // policy to mirror: nothing to observe.
+        return None;
+    }
+    let nr = notif.data.nr as i64;
+    let flags = if nr == libc::SYS_openat || nr == arch::SYS_OPENAT2 {
+        match decode_open_args(notif, notif_fd) {
+            Some(a) => a.flags,
+            None => return None, // kernel's re-read fails the same way
+        }
+    } else {
+        0 // execve/execveat: read/execute access only
+    };
+    if (flags & libc::O_PATH as u64) != 0 {
+        return None; // O_PATH opens are not gated by Landlock
+    }
+    let path = resolve_path_for_notif(notif, notif_fd)?;
+    // Mirror Landlock's symlink resolution: judge the canonical target
+    // first; fall back to the lexical path when it has none yet (e.g.
+    // O_CREAT of a brand-new file).
+    if let Ok(real) = std::fs::canonicalize(&path) {
+        return deny_open_verdict(&real, flags, policy, pfs);
+    }
+    deny_open_verdict(std::path::Path::new(&path), flags, policy, pfs)
+}
+
 /// open/openat/openat2 argument layout, normalized across the spellings.
 struct OpenArgs {
     dirfd: i64,
@@ -2025,9 +2071,26 @@ async fn handle_notification(
                 let is_openat_family = nr == libc::SYS_openat
                     || nr == arch::SYS_OPENAT2
                     || Some(nr) == arch::sys_open();
-                if matches!(action, NotifAction::Continue) && is_openat_family && has_denied {
+                let is_exec_family = nr == libc::SYS_execve || nr == libc::SYS_execveat;
+                if matches!(action, NotifAction::Continue)
+                    && (is_openat_family || is_exec_family)
+                {
                     let pfs = ctx.policy_fn.lock().await;
-                    on_behalf_open_for_deny(&notif, policy, &pfs, fd)
+                    if has_denied && is_openat_family {
+                        on_behalf_open_for_deny(&notif, policy, &pfs, fd)
+                    } else if !has_denied {
+                        // Static-grant mirror (fs observability): deny —
+                        // and thus record on the deny channel — what
+                        // Landlock would deny: an open/exec outside every
+                        // fs grant. Only fires on syscalls that would
+                        // otherwise Continue to the kernel.
+                        match static_fs_grant_deny(&notif, policy, &pfs, fd) {
+                            Some(errno) => NotifAction::Errno(errno),
+                            None => action,
+                        }
+                    } else {
+                        action
+                    }
                 } else {
                     action
                 }
