+/// Structured policy-denial channel (Terrarium M7).
+///
+/// The seccomp supervisor's deny responses are the only authoritative
+/// "this syscall was rejected by policy" signal available to the
+/// supervisor process. Surfacing them as a machine-readable stream lets
+/// the supervising runtime (Terrarium's guest-proxy) classify denials
+/// without sniffing child stderr text.
+///
+/// The channel is a single fd named by `SANDBOX_DENY_FD` in the
+/// supervisor's environment (the owning runtime inherits the write end
+/// into the sandlock process with CLOEXEC cleared). Every deny response
+/// is emitted as one JSON line: `{"syscall":"<name>","errno":<n>}` for
+/// EACCES/EPERM responses and `{"syscall":"<name>","killed":<sig>}` for
+/// supervisor kills. All other responses (ordinary child failures,
+/// EAGAIN defer backpressure, EEXIST COW races, ...) are NOT denials and
+/// are never recorded.
+///
+/// Best-effort by design: a missing/invalid fd, a closed pipe, or a
+/// partial write must never affect sandbox execution — the record is
+/// advisory.
+fn deny_fd() -> Option<i32> {
+    static FD: std::sync::OnceLock<Option<i32>> = std::sync::OnceLock::new();
+    *FD.get_or_init(|| {
+        std::env::var("SANDBOX_DENY_FD")
+            .ok()
+            .and_then(|s| s.parse::<i32>().ok())
+            .filter(|fd| *fd >= 0)
+    })
+}
+
+fn write_deny_record(nr: i64, fields: &str) {
+    if let Some(fd) = deny_fd() {
+        let line = format!("{{\"syscall\":\"{}\",{}}}\n", syscall_name(nr), fields);
+        // Best-effort single write; the pipe is drained by the owner after
+        // the run. A closed pipe (owner gone) is simply ignored.
+        let _ = unsafe {
+            libc::write(fd, line.as_ptr() as *const libc::c_void, line.len())
+        };
+    }
+}
+
+/// Record a policy-denial errno response. EACCES/EPERM are the errno
+/// values the supervisor itself uses when it rejects a syscall; any other
+/// errno is an ordinary failure, not a denial.
+fn maybe_record_deny_errno(nr: i64, errno: i32) {
+    if matches!(errno, libc::EACCES | libc::EPERM) {
+        write_deny_record(nr, &format!("\"errno\":{}", errno));
+    }
+}
+
+/// Record a supervisor kill — the child's process group was killed as a
+/// denial action.
+fn maybe_record_deny_kill(nr: i64, sig: i32) {
+    write_deny_record(nr, &format!("\"killed\":{}", sig));
+}
